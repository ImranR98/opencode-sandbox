{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
    ":configMigration"
  ],
  "labels": [
    "deps"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Auto-merge non-major updates after the required test check passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Auto-merge major updates after the full test gate passes",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "description": "Batch non-major npm updates; majors stay separate",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "npm deps (non-major)"
    },
    {
      "description": "Group Docker base image pins and digest refreshes",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "groupName": "docker base images"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "opencode glibc CLI version baked into the image",
      "managerFilePatterns": [
        "/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG OPENCODE_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "@opencode/cli",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Node LTS version installed by nvm",
      "managerFilePatterns": [
        "/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG NODE_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "nvm version",
      "managerFilePatterns": [
        "/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG NVM_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "nvm-sh/nvm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    }
  ]
}
